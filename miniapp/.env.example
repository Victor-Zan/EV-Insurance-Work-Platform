# Full HTTPS endpoint for the server-side WeChat code exchange and account binding lookup.
# No default endpoint: an unconfigured prototype must not authenticate users.
# AppSecret belongs on the backend only; never add it here.
VITE_WECHAT_LOGIN_URL=
# Preferred shared REST base, including /api/v1; HTTPS only. Leave empty until approved service configuration exists.
VITE_API_BASE_URL=
