# Copy this file to .env for local development only. Never commit .env.

# PostgreSQL container
POSTGRES_DB=ev_insurance
POSTGRES_USER=ev_insurance
POSTGRES_PASSWORD=change-me-for-local-postgres
POSTGRES_PORT=15432

# Backend database connection
DB_URL=jdbc:postgresql://localhost:15432/ev_insurance
DB_USERNAME=ev_insurance
DB_PASSWORD=change-me-for-local-postgres
BACKEND_PORT=8080

# MinIO container
MINIO_ROOT_USER=minio-local-admin
MINIO_ROOT_PASSWORD=change-me-for-local-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Frontend API entry
VITE_API_BASE_URL=/api/v1


# JWT: supply a randomly generated Base64 key of at least 32 bytes. No source-code fallback.
JWT_SECRET_BASE64=
# Access token lifetime in seconds, default local setup is 30 minutes. No refresh tokens.
JWT_TTL_SECONDS=1800
# Explicit allowed browser origins. Use deployed origins in deployment configuration.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Only opt into dev on a local disposable database; do not enable in production.
SPRING_PROFILES_ACTIVE=
# Needed with SPRING_PROFILES_ACTIVE=dev. Inject local secrets; never commit their values.
DEV_ADMIN_PASSWORD=
DEV_CUSTOMER_SERVICE_PASSWORD=
DEV_REPAIR_SHOP_PASSWORD=
DEV_OWNER_PASSWORD=

# Dedicated test PostgreSQL (postgres-it profile creates a random isolated schema).
TEST_DB_URL=jdbc:postgresql://localhost:15432/ev_insurance_test
TEST_DB_USERNAME=
TEST_DB_PASSWORD=
