# Copy this file to .env for local development only. Never commit .env.

# PostgreSQL container
POSTGRES_DB=ev_insurance
POSTGRES_USER=ev_insurance
POSTGRES_PASSWORD=change-me-for-local-postgres
POSTGRES_PORT=15432

# Backend database connection
DB_URL=jdbc:postgresql://localhost:15432/ev_insurance
DB_USERNAME=ev_insurance
DB_PASSWORD=change-me-for-local-postgres
BACKEND_PORT=8080

# MinIO container
MINIO_ROOT_USER=minio-local-admin
MINIO_ROOT_PASSWORD=change-me-for-local-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Frontend API entry
VITE_API_BASE_URL=http://localhost:8080/api/v1
