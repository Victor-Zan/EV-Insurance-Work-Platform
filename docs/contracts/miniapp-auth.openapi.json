  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "WechatUser": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "enabled": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "activated": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "OWNER",
                "REPAIR_SHOP"
              ]
            }
          },
          "shopId": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "username",
          "displayName",
          "enabled",
          "activated",
          "roles",
          "shopId"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "roles": {
                  "contains": {
                    "const": "OWNER"
                  }
                }
              }
            },
            "then": {
              "properties": {
                "shopId": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "shopId": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              }
            }
          }
        ]
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "writeOnly": true,
            "description": "Fresh opaque wx.login code; never log, persist or automatically replay."
          }
        },
        "required": [
          "code"
        ]
      },
      "BindRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "writeOnly": true,
            "description": "Fresh opaque wx.login code; never log, persist or automatically replay."
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "writeOnly": true,
            "description": "Nonblank, at most 72 UTF-8 bytes; maxLength alone is insufficient."
          },
          "confirmed": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "code",
          "username",
          "password",
          "confirmed"
        ]
      },
      "InspectRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "writeOnly": true
          }
        },
        "required": [
          "token"
        ]
      },
      "ActivateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "writeOnly": true
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "writeOnly": true,
            "description": "Fresh opaque wx.login code; never log, persist or automatically replay."
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "writeOnly": true,
            "description": "Nonblank, at most 72 UTF-8 bytes; maxLength alone is insufficient."
          },
          "confirmPassword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "writeOnly": true,
            "description": "Nonblank, at most 72 UTF-8 bytes; maxLength alone is insufficient."
          },
          "confirmed": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "token",
          "code",
          "password",
          "confirmPassword",
          "confirmed"
        ]
      },
      "OwnerInvitationRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          },
          "verified": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "existingOwnerId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "expectedVersion",
          "verified",
          "reason"
        ]
      },
      "RevokeRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          },
          "verified": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "expectedVersion",
          "verified",
          "reason"
        ]
      },
      "LoginResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accessToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "readOnly": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/WechatUser"
          }
        },
        "required": [
          "accessToken",
          "expiresAt",
          "user"
        ]
      },
      "InvitationPreview": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "displayNameMasked": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "usernameMasked": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "REPAIR_SHOP"
            ]
          },
          "shopNameMasked": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "displayNameMasked",
          "usernameMasked",
          "role",
          "expiresAt"
        ]
      },
      "Invitation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "userId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "alreadyActive": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "entryPath": {
            "type": "string",
            "enum": [
              "pages/activate/index",
              "pages/login/index"
            ]
          },
          "invitationToken": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "readOnly": true,
            "description": "Returned once to authorized inviter; never log or persist plaintext."
          }
        },
        "required": [
          "userId",
          "username",
          "alreadyActive",
          "expiresAt",
          "entryPath",
          "invitationToken"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "alreadyActive": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "expiresAt": {
                  "type": "null"
                },
                "invitationToken": {
                  "type": "null"
                },
                "entryPath": {
                  "const": "pages/login/index"
                }
              }
            },
            "else": {
              "properties": {
                "expiresAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "invitationToken": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "entryPath": {
                  "const": "pages/activate/index"
                }
              }
            }
          }
        ]
      },
      "BindingView": {
        "type": "object",
